{
  "name": "moodfood",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MoodFood \u2014 an interactive mood kiosk for IPC Shopping Centre Damansara",
  "scripts": {
    "postinstall": "node scripts/copy-models.mjs",
    "dev": "vite --host",
    "build": "tsc --noEmit && npm run test && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "models": "node scripts/copy-models.mjs",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/mood/scoring.test.mts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/nunito": "^5.2.5",
    "@vladmandic/face-api": "^1.7.15",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  }
}
